[Unit]
Description=EdgeBounty readiness and disk checks
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/edgebounty-usdc-20261017-master
ExecStart=/usr/bin/env node scripts/health-check.mjs
ExecStopPost=/usr/bin/env node scripts/send-security-alert.mjs
Environment=PATH=/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=30
