# Copy to .env and configure private values. Use a NEW database/ledger for USDC.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
APP_DOMAIN=example.com
CORS_ORIGINS=https://example.com
DATABASE_URL=postgres://edgebounty:CHANGE_ME@127.0.0.1:5432/edgebounty_usdc
DATA_DIR=/var/lib/edgebounty-usdc
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GATEWAY_SHARED_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DOWNLOAD_GATEWAY_URL=https://downloads.example.com
SOLANA_RPC_URL=https://YOUR_RPC
PROGRAM_ID=YOUR_DEPLOYED_PROGRAM
PAYMENT_CURRENCY=USDC
PAYMENT_MINT=YOUR_VERIFIED_SIX_DECIMAL_USDC_MINT
STORAGE_DRIVER=r2
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_DIRECT_TRANSFERS=1
S3_RATE_MICRO_PER_GB_MONTH=15000
FREE_STORAGE_BYTES=1073741824
MAX_FILE_BYTES=536870912000
MAX_UPLOAD_BYTES=536870912000
VERIFICATION_MAX_MATERIALIZE_BYTES=268435456
AI_PROVIDER=nvidia
NVIDIA_API_KEY=REPLACE_ME
# Optional future Gemini provider. Set current model-specific rates before enabling paid jobs.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_INPUT_MICRO_PER_MILLION=
# GEMINI_OUTPUT_MICRO_PER_MILLION=
SANDBOX=docker
DOCKER_USE_SUDO=0
# Run apps/api/src/worker.ts separately with the same private environment and PostgreSQL.
VERIFICATION_EXECUTOR=worker
# PostgreSQL must have the vector extension installed before enabling this.
SEMANTIC_DUPLICATES=on
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
WORKERS=on
